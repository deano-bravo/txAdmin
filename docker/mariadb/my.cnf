# ============================================================================
# MariaDB Performance Tuning for txAdmin / FiveM Game Server Stack
# Optimized for high-throughput game data with acceptable durability trade-offs
# ============================================================================

[mysqld]
# --- Character Set -----------------------------------------------------------
character-set-server   = utf8mb4
collation-server       = utf8mb4_unicode_ci

# --- InnoDB Engine (primary performance levers) ------------------------------
# Buffer pool: cache hot data in RAM — size to ~60-70% of container memory
innodb_buffer_pool_size        = 512M
innodb_buffer_pool_instances   = 2
innodb_log_file_size           = 128M
innodb_log_buffer_size         = 16M

# Write performance: flush once per second instead of every commit.
# Trades 1-second durability window for major write throughput gain.
# Acceptable for game server data that can tolerate a 1-second loss on crash.
innodb_flush_log_at_trx_commit = 2
innodb_flush_method            = O_DIRECT

# I/O tuning
innodb_io_capacity             = 2000
innodb_io_capacity_max         = 4000
innodb_read_io_threads         = 4
innodb_write_io_threads        = 4

# Disable doublewrite for speed (data on modern filesystems is rarely corrupted)
innodb_doublewrite             = OFF

# --- Connection & Thread Pool ------------------------------------------------
max_connections     = 200
thread_cache_size   = 16
back_log            = 128

# --- Query Cache (useful for repetitive game data reads) ---------------------
query_cache_type    = 1
query_cache_size    = 64M
query_cache_limit   = 2M

# --- Temporary Tables --------------------------------------------------------
tmp_table_size      = 64M
max_heap_table_size = 64M

# --- Key Buffer (MyISAM — small since we primarily use InnoDB) ---------------
key_buffer_size     = 32M

# --- Network -----------------------------------------------------------------
# Skip reverse DNS lookups on client connections — eliminates DNS latency
skip-name-resolve

# Maximum allowed packet size (handles large game data payloads)
max_allowed_packet  = 64M

# --- Table Cache -------------------------------------------------------------
table_open_cache       = 400
table_definition_cache = 400

# --- Binary Logging (disabled for single-node performance) -------------------
skip-log-bin

# --- Slow Query Log (enable for diagnostics, disable in production) ----------
slow_query_log      = OFF
long_query_time     = 2

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4
