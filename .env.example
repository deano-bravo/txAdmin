# ============================================================================
# txAdmin Docker Stack — Environment Variables
# Copy this file to .env and fill in the values before running docker compose
# ============================================================================

# --- Required: MariaDB Credentials ------------------------------------------
MARIADB_ROOT_PASSWORD=changeme_root_password
MARIADB_PASSWORD=changeme_txadmin_password

# --- txAdmin Build Version ---------------------------------------------------
# Baked into the image at build time (refs/tags/ format)
TX_VERSION=v0.0.0-docker

# --- txAdmin Runtime Configuration ------------------------------------------
TXHOST_GAME_NAME=fivem
TXHOST_QUIET_MODE=false
# TXHOST_API_TOKEN=

# --- Port Mapping (host ports) ----------------------------------------------
TXHOST_TXA_PORT=40120
TXHOST_FXS_PORT=30120

# --- Optional: CFX.re License Key -------------------------------------------
# TXHOST_DEFAULT_CFXKEY=

# --- NVIDIA GPU Configuration -----------------------------------------------
# Set to specific GPU IDs to restrict access, or "all" for all GPUs
NVIDIA_VISIBLE_DEVICES=all
