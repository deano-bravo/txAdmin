# ============================================================================
# txAdmin Docker Stack — Environment Variables
# Copy this file to .env and fill in the values before running docker compose
# ============================================================================

# --- Required: MariaDB Credentials ------------------------------------------
# Security: Use 20+ random characters. Root and app passwords MUST differ.
MARIADB_ROOT_PASSWORD=changeme_root_password
MARIADB_PASSWORD=changeme_txadmin_password

# --- txAdmin Build Version ---------------------------------------------------
# Baked into the image at build time (refs/tags/ format)
TX_VERSION=v0.0.0-docker

# --- txAdmin Runtime Configuration ------------------------------------------
TXHOST_GAME_NAME=fivem
TXHOST_QUIET_MODE=false
# TXHOST_API_TOKEN=

# --- Port Mapping (host ports) ----------------------------------------------
TXHOST_TXA_PORT=40120
TXHOST_FXS_PORT=30120

# --- Optional: CFX.re License Key -------------------------------------------
# TXHOST_DEFAULT_CFXKEY=

# --- NVIDIA GPU Configuration -----------------------------------------------
# Set to specific GPU IDs to restrict access, or "all" for all GPUs
NVIDIA_VISIBLE_DEVICES=all

# ============================================================================
# Development Variables (used by Vite dev servers and scripts/build/dev.ts)
# These are NOT needed for production Docker builds.
# ============================================================================

# Required: Path to your local FXServer installation
# TXDEV_FXSERVER_PATH=/path/to/fxserver

# Panel Vite dev server URL (default: http://localhost:40122)
# TXDEV_VITE_URL=http://localhost:40122

# Enable verbose dev logging
# TXDEV_VERBOSE=false

# Optional: CFX.re license key for dev testing
# TXDEV_CFXKEY=

# Optional: Steam API key for dev testing
# TXDEV_STEAMKEY=

# Optional: External stats host
# TXDEV_EXT_STATS_HOST=

# Optional: Additional FXServer launch arguments (space-separated)
# TXDEV_LAUNCH_ARGS=
